{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://www.8crafter.com/schemas/ouic/theme/manifest.schema.json",
    "title": "Theme manifest.json Schema for 8Crafter's Ore UI Customizer",
    "description": "The JSON schema of the `manifest.json` file of a theme for 8Crafter's Ore UI Customizer.",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The JSON schema of the `manifest.json` file of a theme for 8Crafter's Ore UI Customizer.",
            "type": "string",
            "default": "https://www.8crafter.com/schemas/ouic/theme/manifest.schema.json"
        }
    },
    "oneOf": [
        {
            "required": ["format_version", "header"],
            "properties": {
                "format_version": {
                    "title": "Format Version",
                    "description": "This defines the current version of the manifest. Don't change this unless you have a good reason to.",
                    "const": 1
                },
                "header": {
                    "title": "Header",
                    "description": "The header of the theme manifest.",
                    "type": "object",
                    "required": ["name", "id", "uuid", "namespace", "version", "format_version"],
                    "properties": {
                        "name": {
                            "title": "Name",
                            "description": "The display name of the theme.",
                            "type": "string",
                            "examples": ["My Custom Theme"]
                        },
                        "uuid": {
                            "title": "UUID",
                            "description": "The UUID of the theme, used to uniquely identify the theme.\nMust be a valid UUID v4.",
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                            "$comment": "Do not put an example for this as it may encourage some users to use it, which will result in multiple themes having the same UUID."
                        },
                        "description": {
                            "title": "Description",
                            "description": "An optional description of the theme.",
                            "type": "string"
                        },
                        "version": {
                            "title": "Version",
                            "description": "The version of the theme.\nThis must be a valid semver string, without the leading `v`.",
                            "type": "string",
                            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
                            "default": "1.0.0",
                            "examples": [
                                "0.0.1-alpha",
                                "0.0.1-alpha.1",
                                "0.0.1-alpha.1+BUILD.1",
                                "1.0.0-alpha.1",
                                "1.0.0-alpha.1+BUILD.1",
                                "1.0.0-beta",
                                "1.0.0-beta.1",
                                "1.0.0-beta.1+BUILD.1",
                                "1.0.0-preview.20",
                                "1.0.0-preview.20+BUILD.1",
                                "1.0.0-rc.1",
                                "1.0.0-rc.1+BUILD.1",
                                "1.0.0",
                                "1.0.0+BUILD.1",
                                "1.0.1-rc.5",
                                "3.17.4-preview.20+BUILD.5"
                            ]
                        },
                        "format_version": {
                            "title": "Format Version",
                            "description": "The version of 8Crafter's Ore UI Customizer that this theme is made for.",
                            "type": "string",
                            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
                            "default": "1.17.0",
                            "examples": ["1.17.0+BUILD.8", "1.17.0"],
                            "$comment": "The default value of this should be the latest version of the Ore UI Customizer. The examples of this should include every version of the Ore UI Customizer since full theme support was added."
                        },
                        "min_engine_version": {
                            "title": "Min Engine Version",
                            "description": "The minimum version of 8Crafter's Ore UI Customizer that this theme is compatible with.\nThis must be a valid semver string, without the leading `v`.\nIf not specified, no check will be done. Otherwise, if this version is higher than the version of 8Crafter's Ore UI Customizer running, the theme will fail to import.",
                            "type": "string",
                            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
                            "examples": ["1.17.0+BUILD.8", "1.17.0"],
                            "$comment": "This should not have a default value. The examples of this should include every version of the Ore UI Customizer back to 1.17.0+BUILD.8."
                        }
                    },
                    "unevaluatedProperties": false
                },
                "icon_data_uri": {
                    "title": "Icon Data URI",
                    "description": "The data URI of the icon of the theme.\nIf not specified the default icon will be used.\nThe MIME type must match `image/*`.",
                    "pattern": "^data:image\\/[^;]+;base64,[a-zA-Z0-9+/=]+$",
                    "examples": ["data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8/x8AAwMCAO+ip1sAAAAASUVORK5CYII="]
                },
                "dependencies": {
                    "title": "Dependencies",
                    "description": "The dependencies of the theme.\nThese dependencies can be other themes, plugins, or configs.",
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "title": "Dependency",
                        "description": "A dependency of the theme.",
                        "type": "object",
                        "oneOf": [
                            {
                                "title": "External Dependency",
                                "description": "A theme, plugin, or config dependency.",
                                "required": ["uuid"],
                                "properties": {
                                    "uuid": {
                                        "title": "UUID",
                                        "description": "The UUID of the theme, plugin, or config dependency.\nMust be a valid UUID v4.\nMay also be the UUID of a built-in theme, plugin, or config to force the user to have it enabled to use the theme.",
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                                    },
                                    "version": {
                                        "title": "Version",
                                        "description": "The version of the theme, plugin, or config dependency.\nMust be a valid semver string, without the leading `v`.\nIf no version is specified, the latest available version will match, or whatever version is currently active.\nNOTE: This field is ignored when the dependency is a built-in theme, plugin, or config.",
                                        "type": "string",
                                        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
                                    }
                                }
                            }
                        ],
                        "unevaluatedProperties": false
                    }
                },
                "metadata": {
                    "title": "Metadata",
                    "description": "Additonal metadata about the theme.",
                    "type": "object",
                    "required": ["product_type"],
                    "properties": {
                        "authors": {
                            "title": "Authors",
                            "description": "The authors of the theme.",
                            "type": "array",
                            "items": {
                                "title": "Author",
                                "description": "An author of the theme.",
                                "type": "string"
                            },
                            "examples": [["8Crafter", "StormStqr"]]
                        },
                        "url": {
                            "title": "URL",
                            "description": "The URL of the website for the theme, or just the theme creator's website.",
                            "type": "string",
                            "examples": ["https://www.8crafter.com"]
                        },
                        "product_type": {
                            "title": "Product Type",
                            "description": "The product type.",
                            "type": "string",
                            "enum": ["theme"]
                        },
                        "license": {
                            "title": "License",
                            "description": "The license of the theme.",
                            "type": "string",
                            "examples": [
                                "0BSD",
                                "AFL-3.0",
                                "AGPL-3.0",
                                "APACHE-2.0",
                                "ARTISTIC-2.0",
                                "BLUEOAK-1.0.0",
                                "BSD-2-CLAUSE-PATENT",
                                "BSD-2-CLAUSE",
                                "BSD-3-CLAUSE-CLEAR",
                                "BSD-3-CLAUSE",
                                "BSD-4-CLAUSE",
                                "BSL-1.0",
                                "CC-BY-4.0",
                                "CC-BY-SA-4.0",
                                "CC0-1.0",
                                "CECILL-2.1",
                                "CERN-OHL-P-2.0",
                                "CERN-OHL-S-2.0",
                                "CERN-OHL-W-2.0",
                                "ECL-2.0",
                                "EPL-1.0",
                                "EPL-2.0",
                                "EUPL-1.1",
                                "EUPL-1.2",
                                "GFDL-1.3",
                                "GPL-2.0",
                                "GPL-3.0",
                                "ISC",
                                "LGPL-2.1",
                                "LGPL-3.0",
                                "LPPL-1.3C",
                                "MIT-0",
                                "MIT",
                                "MPL-2.0",
                                "MS-PL",
                                "MS-RL",
                                "MULANPSL-2.0",
                                "NCSA",
                                "ODBL-1.0",
                                "OFL-1.1",
                                "OSL-3.0",
                                "POSTGRESQL",
                                "UNLICENSE",
                                "UPL-1.0",
                                "VIM",
                                "WTFPL",
                                "ZLIB"
                            ]
                        }
                    },
                    "additionalProperties": true,
                    "default": {
                        "product_type": "theme"
                    }
                },
                "marketplaceDetails": {
                    "title": "Marketplace Details",
                    "description": "The details of the theme in the marketplace.\nThis is only used if the theme is from the marketplace.\nThis should not be included when uploading the theme to the marketplace, as the server will handle adding this information.\nThis is mutually exclusive with checkForUpdatesDetails.",
                    "type": "object",
                    "required": ["marketplaceId", "originalDownloadURL", "marketplaceURL"],
                    "properties": {
                        "marketplaceId": {
                            "title": "Marketplace ID",
                            "description": "The ID of the theme in the marketplace.\nShould be in the format `${themePublisher}.${id}`.",
                            "type": "string",
                            "pattern": ".\\.[a-zA-Z0-9_.-]+$",
                            "examples": ["8crafter.my-custom-theme"],
                            "not": {
                                "$comment": "Disallow using the example as the actual value in the theme.",
                                "enum": ["8crafter.my-custom-theme"]
                            }
                        },
                        "originalDownloadURL": {
                            "title": "Original Download URL",
                            "description": "The original download URL of the theme in the marketplace.",
                            "type": "string",
                            "pattern": "^https://marketplace\\.ore-ui-customizer\\.8crafter\\.com/download/theme/[^/]+\\.[a-zA-Z0-9_.-]+/[^/]+$",
                            "examples": ["https://marketplace.ore-ui-customizer.8crafter.com/download/theme/8crafter.my-custom-theme/1.0.0"],
                            "not": {
                                "$comment": "Disallow using the example as the actual value in the theme.",
                                "pattern": "^https://marketplace\\.ore-ui-customizer\\.8crafter\\.com/download/theme/8crafter\\.my-custom-theme/"
                            }
                        },
                        "marketplaceURL": {
                            "title": "Marketplace URL",
                            "description": "The URL of the theme in the marketplace.",
                            "type": "string",
                            "pattern": "^https://marketplace\\.ore-ui-customizer\\.8crafter\\.com/theme/[^/]+\\.[^/]+$",
                            "examples": ["https://marketplace.ore-ui-customizer.8crafter.com/theme/8crafter.my-custom-theme"],
                            "not": {
                                "$comment": "Disallow using the example as the actual value in the theme.",
                                "enum": ["https://marketplace.ore-ui-customizer.8crafter.com/theme/8crafter.my-custom-theme"]
                            }
                        }
                    },
                    "unevaluatedProperties": false
                },
                "checkForUpdatesDetails": {
                    "title": "Check for Updates Details",
                    "description": "The details of the theme to check for updates.\nThis is only used if the theme is not from the marketplace.\nThis allows non-marketplace themes to be checked for updates.\nThis is mutually exclusive with marketplaceDetails.",
                    "type": "object",
                    "required": ["versionInfoURL"],
                    "properties": {
                        "versionInfoURL": {
                            "title": "Version Info URL",
                            "description": "The URL to the JSON object containing the newest version of the theme.\nThe response from this URL should match the https://www.8crafter.com/schemas/ouic/theme/checkForUpdatesDetailsVersionInfoResponse.schema.json schema.\nWhen fetching the URL, the response should have an MIME type of `application/json` or `text/json`.",
                            "type": "string",
                            "examples": ["https://example.com/ore-ui-customizer-themes/my-custom-theme/latestVersion.json"]
                        }
                    },
                    "unevaluatedProperties": false
                }
            },
            "allOf": [
                {
                    "not": {
                        "required": ["marketplaceDetails", "checkForUpdatesDetails"],
                        "properties": {
                            "marketplaceDetails": true,
                            "checkForUpdatesDetails": true
                        }
                    }
                }
            ]
        }
    ],
    "unevaluatedProperties": false,
    "allowComments": true,
    "allowTrailingCommas": true
}
